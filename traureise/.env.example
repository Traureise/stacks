# This server's address on the private network; Traureise listens there (port PORT) for the reverse proxy.
PRIVATE_IP=10.0.0.3
PORT=3010

# The public URL, used in login and share links. https:// marks the session cookie Secure.
APP_URL=https://traureise.example

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Login emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Traureise <hallo@traureise.example>

# Billing through Creem; off until the legal texts include terms and the products exist.
BILLING_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_RSVP=
CREEM_PRODUCT_INVITATIONS=
CREEM_PRODUCT_COMPLETE=
